# Gladiator — copy to `.env` and fill in. Never commit `.env`.
#
# There is no login screen and no user table: the app runs as a single
# identity, and every credential it will ever need lives here (and in the
# Vercel project's encrypted environment variables).

# Neon Postgres. Use the pooled connection string for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Direct (non-pooled) connection — only needed if migrations misbehave over the pooler.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Canvas ---
# Canvas → Account → Settings → Approved Integrations → New Access Token.
# Canvas can now be connected from inside the app (Front page → Connect Canvas),
# which stores the credentials in the database and is what a student should use.
# These vars still work and act as the fallback when nothing is stored; a value
# set in the app takes precedence.
CANVAS_BASE_URL="https://YOURSCHOOL.instructure.com"
CANVAS_TOKEN=""

# Fallback for when personal access tokens are disabled: the private "Calendar
# Feed" URL from the Canvas calendar sidebar. Due dates only, no grades. If this
# is set, the sync uses it automatically when the token is missing or rejected.
CANVAS_ICAL_URL=""

# Optional. Not a login — it only stops a public URL from triggering syncs.
# When set, POST /api/sync requires `Authorization: Bearer <value>`.
# SYNC_SECRET=""

# --- Google Calendar ---
# Personal Google account, NOT the school Workspace account. Google Cloud project
# stays in Testing mode with you as the only test user — no verification needed.
# OAuth client type: "Web application". Scope: calendar.events only.
# Google OAuth *app* credentials. These identify the deployment, not the
# student — creating them means owning a Google Cloud project, so they can only
# come from whoever runs this. Without them the app says Google Calendar is
# unavailable rather than offering a button that cannot work.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Must match an Authorised redirect URI on the OAuth client exactly.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# Minted once by visiting /api/google/auth and consenting. Long-lived.
# The *account*. No longer needs setting by hand: pressing "Connect Google
# Calendar" runs the consent flow and stores this in the database. Kept as a
# fallback for existing deployments; a stored value wins.
GOOGLE_REFRESH_TOKEN=""

# Which calendar to write to. "primary" is the personal account's main calendar;
# a dedicated calendar is easier to hide or delete wholesale.
# GOOGLE_CALENDAR_ID="primary"

# Set on the Vercel project so scheduled runs are authenticated. Vercel attaches
# this automatically to cron requests as `Authorization: Bearer <value>`.
# CRON_SECRET=""

# Floor between opening-the-app refreshes. This is what keeps the unauthenticated
# /api/sync/auto endpoint from being usable to burn Canvas rate limit.
# AUTO_SYNC_MIN_INTERVAL_MINUTES="10"

# --- LLM ---
# "openai" (default) or "anthropic". All vendor code lives in src/lib/llm.ts,
# so switching providers is this variable plus a key — nothing else changes.
LLM_PROVIDER="openai"
LLM_API_KEY=""

# Any OpenAI-compatible endpoint — Hack Club's student tier, OpenRouter, a
# self-hosted proxy. Leave unset for OpenAI itself. The wire format is the same;
# if the gateway lacks strict structured outputs the client retries in plain
# JSON mode automatically.
# LLM_BASE_URL="https://ai.hackclub.com/v1"

# Optional per-tier model overrides. Verify the ids against your provider's
# current model list before relying on them.
#
# Defaults: openai gpt-4o-mini for BOTH tiers, anthropic claude-haiku-4-5 /
# claude-opus-5.
#
# Both OpenAI tiers are mini on purpose — it is the difference between a few
# dollars a month and well under one, because the nightly digest runs once per
# class per school day. Set LLM_MODEL_STRONG="gpt-4o" to put the digest, the
# daily-plan narrative and the weekly retro back on the better writer.
#
# Anthropic is now Haiku 4.5 on both tiers too. Opus, gpt-4.5 and o1-pro are
# refused outright — the digest runs unattended nightly and a frontier model
# there is one to two orders of magnitude, not a slightly bigger bill. Set
# LLM_ALLOW_EXPENSIVE_MODELS=1 if you genuinely mean it.
# LLM_MODEL_FAST=""
# LLM_MODEL_STRONG=""

# --- Daily plan ---
# The window the planner is allowed to schedule work in, local time.
# PLAN_WINDOW_START="16:00"
# PLAN_WINDOW_END="21:30"

# ── Daily schedule ────────────────────────────────────────────────────────────
# When the evening's study window opens and closes (local time, 24h). Work is
# only ever scheduled inside this, minus anything already on your calendar.
PLAN_WINDOW_START=16:00
PLAN_WINDOW_END=21:30

# How the day is broken up. Longest unbroken run of work, the breather between
# runs, and a longer one every Nth break.
PLAN_FOCUS_MINUTES=50
PLAN_BREAK_MINUTES=10
PLAN_LONG_BREAK_MINUTES=20
PLAN_LONG_BREAK_EVERY=3

# Dinner is reserved before any work is placed — work bends around it, not the
# other way round. If the window opens after this time, it moves to the start of
# the window rather than being skipped.
PLAN_DINNER_START=18:00
PLAN_DINNER_MINUTES=45

# ── Home Access Center ────────────────────────────────────────────────────────
# Required before a HAC password can be stored. Any long random string; it is
# the key the password is encrypted with, so changing it makes a stored password
# unreadable and you will need to reconnect.
#
#   openssl rand -base64 48
#
# HAC is the one integration that needs a real district password rather than a
# revocable token. The address and username are entered in the app.
CREDENTIAL_SECRET=
